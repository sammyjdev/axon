# AXON environment template
# Most users only need to review these values after `./setup.sh` creates `.env.local`.
# The usual edits are: engine path and vault path. No provider key is needed:
# AXON calls no LLM and no embedding provider (dec-138).

# Required local paths
AXON_ENGINE=~/dev/axon
AXON_VAULT=~/vault

# Setup/bootstrap mode. setup.sh persists the resolved mode into .env.local.
# Supported values: full-local, hybrid-local, remote-infra, minimal.
AXON_RUNTIME_MODE=full-local

# Optional: point setup.sh at a remote Docker host before running it.
# setup.sh writes the matching service URLs into `.env.local` automatically.
# AXON_INFRA_HOST=192.168.x.x

# Autenticação do `axon serve-http` (#93). Com o token setado, toda rota exceto
# /health exige `Authorization: Bearer <token>`; o dashboard recebe um cookie
# HttpOnly no GET /dashboard para que suas próprias chamadas /api funcionem.
# Sem token, o comando RECUSA bind não-loopback - use
# AXON_HTTP_ALLOW_UNAUTHENTICATED=1 apenas se já houver auth na frente.
# AXON_HTTP_TOKEN=

# Lessons corpus DB - deliberately separate from every other store's DSN
# (no default): a client's lessons live in the client's database, not
# wherever AXON_PG_URL happens to point.
# AXON_LESSONS_PG_URL=postgresql://axon:axon@localhost:5433/axon_lessons

# Single backend (dec-121): the axon-postgres service in docker-compose.yml.
# Point at another port if docker-compose.override.yml remaps it.
AXON_PG_URL=postgresql://axon:axon@localhost:5433/axon

# Optional remote infra host reported by `axon doctor`.
AXON_OLLAMA_REMOTE_HOST=

AXON_POLICY_VERSION=2026-04-21

# Platform-generated defaults that setup.sh refreshes
AXON_PLATFORM=mac

# Tree whose sessions are never imported into the activity history (default ~/dev/client-a).
# AXON_RESTRICTED_ROOT=~/dev/client-a

# Comma-separated projects whose ADRs get_adrs returns only with ctx=work.
# AXON_WORK_PROJECTS=client-a
